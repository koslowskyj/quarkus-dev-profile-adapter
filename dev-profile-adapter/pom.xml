<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.koslowskyj</groupId>
        <artifactId>dev-profile-adapter-parent</artifactId>
        <version>3.40.0-SNAPSHOT</version>
    </parent>

    <artifactId>dev-profile-adapter</artifactId>
    <name>Dev Profile Adapter - Runtime</name>
    <description>Adopts a QuarkusTestProfile in quarkus:dev: starts its test resources and injects their config.</description>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <executions>
                    <execution>
                        <id>extension-descriptor</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                        <configuration>
                            <deployment>${project.groupId}:${project.artifactId}-deployment:${project.version}</deployment>
                            <!-- One adapter line per Quarkus line: the processor uses Quarkus-internal APIs. -->
                            <requiresQuarkusCore>[3.40,3.41)</requiresQuarkusCore>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
